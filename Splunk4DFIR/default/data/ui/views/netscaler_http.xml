<form version="1.1" theme="dark">
  <label>NetScaler HTTP Access</label>
  <fieldset submitButton="true">
    <input type="time" token="timepicker">
      <label>Time span</label>
      <default>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
    <input type="text" token="text_filter">
      <label>Free SPL input</label>
      <default>*</default>
      <prefix/>
      <suffix/>
    </input>
    <input type="multiselect" token="selected_source" searchWhenChanged="true">
      <label>Select source log file</label>
      <search>
        <query>`netscaler-http` src=* 
    | fields source 
    | dedup source</query>
      </search>
      <fieldForLabel>source</fieldForLabel>
      <fieldForValue>source</fieldForValue>
      <delimiter> , </delimiter>
      <default>*</default>
      <valuePrefix>"</valuePrefix>
      <valueSuffix>"</valueSuffix>
      <choice value="*">ALL</choice>
    </input>
    <input type="multiselect" token="src" searchWhenChanged="true">
      <label>Source IP</label>
      <search>
        <query>`netscaler-http` src=* source IN ( $selected_source$ )
    | fields src
    | dedup src</query>
      </search>
      <fieldForLabel>src</fieldForLabel>
      <fieldForValue>src</fieldForValue>
      <delimiter> , </delimiter>
      <default>*</default>
      <valuePrefix>"</valuePrefix>
      <valueSuffix>"</valueSuffix>
      <choice value="*">ALL</choice>
    </input>
    <input type="multiselect" token="dest" searchWhenChanged="true">
      <label>Destination</label>
      <search>
        <query>`netscaler-http` src=* source IN ( $selected_source$ )
    | fields dest
    | dedup dest</query>
      </search>
      <fieldForLabel>dest</fieldForLabel>
      <fieldForValue>dest</fieldForValue>
      <delimiter> , </delimiter>
      <default>*</default>
      <valuePrefix>"</valuePrefix>
      <valueSuffix>"</valueSuffix>
      <choice value="*">ALL</choice>
    </input>
    <input type="multiselect" token="http_method" searchWhenChanged="true">
      <label>HTTP Method</label>
      <search>
        <query>`netscaler-http` src=* source IN ( $selected_source$ )
    | fields http_method
    | dedup http_method</query>
      </search>
      <fieldForLabel>http_method</fieldForLabel>
      <fieldForValue>http_method</fieldForValue>
      <delimiter> , </delimiter>
      <default>*</default>
      <valuePrefix>"</valuePrefix>
      <valueSuffix>"</valueSuffix>
      <choice value="*">ALL</choice>
    </input>
    <input type="multiselect" token="status" searchWhenChanged="true">
      <label>HTTP Status</label>
      <search>
        <query>`netscaler-http` src=* source IN ( $selected_source$ )
    | fields status
    | dedup status</query>
      </search>
      <fieldForLabel>status</fieldForLabel>
      <fieldForValue>status</fieldForValue>
      <delimiter> , </delimiter>
      <default>*</default>
      <valuePrefix>"</valuePrefix>
      <valueSuffix>"</valueSuffix>
      <choice value="*">ALL</choice>
    </input>
    <input type="multiselect" token="http_user_agent" searchWhenChanged="true">
      <label>User Agent</label>
      <search>
        <query>`netscaler-http` src=* source IN ( $selected_source$ )
    | fields http_user_agent
    | dedup http_user_agent</query>
      </search>
      <fieldForLabel>http_user_agent</fieldForLabel>
      <fieldForValue>http_user_agent</fieldForValue>
      <delimiter> , </delimiter>
      <default>*</default>
      <valuePrefix>"</valuePrefix>
      <valueSuffix>"</valueSuffix>
      <choice value="*">ALL</choice>
    </input>
  </fieldset>
  <row>
    <panel>
      <title>Source IP GeoIP HeatMap</title>
      <map>
        <search>
          <query>
`netscaler-http` src=* $text_filter$
src IN ( $src$ )
dest IN ( $dest$ )
http_method IN ( $http_method$ )
status IN ( $status$ )
http_user_agent IN ( $http_user_agent$ )
source IN ( $selected_source$ )
| fields src
| iplocation src
| geostats latfield=lat longfield=lon count by src
          </query>
          <earliest>$timepicker.earliest$</earliest>
          <latest>$timepicker.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="mapping.type">marker</option>
        <option name="refresh.display">progressbar</option>
      </map>
    </panel>
  </row>
  <row>
    <panel>
      <title>HTTP Method Distribution</title>
      <chart>
        <search>
          <query>
`netscaler-http` src=* $text_filter$
src IN ( $src$ )
dest IN ( $dest$ )
http_method IN ( $http_method$ )
status IN ( $status$ )
http_user_agent IN ( $http_user_agent$ )
source IN ( $selected_source$ )
| stats count by http_method
| sort - count
        </query>
          <earliest>$timepicker.earliest$</earliest>
          <latest>$timepicker.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.drilldown">all</option>
        <drilldown>
          <set token="http_method">"$click.value$"</set>
        </drilldown>
      </chart>
    </panel>
    <panel>
      <title>HTTP Status Distribution</title>
      <chart>
        <search>
          <query>
`netscaler-http` src=* $text_filter$
src IN ( $src$ )
dest IN ( $dest$ )
http_method IN ( $http_method$ )
status IN ( $status$ )
http_user_agent IN ( $http_user_agent$ )
source IN ( $selected_source$ )
| stats count by status
| sort - count
        </query>
          <earliest>$timepicker.earliest$</earliest>
          <latest>$timepicker.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.drilldown">all</option>
        <drilldown>
          <set token="status">"$click.value$"</set>
        </drilldown>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Source IP Distribution</title>
      <chart>
        <search>
          <query>
`netscaler-http` src=* $text_filter$
src IN ( $src$ )
dest IN ( $dest$ )
http_method IN ( $http_method$ )
status IN ( $status$ )
http_user_agent IN ( $http_user_agent$ )
source IN ( $selected_source$ )
| stats count by src
| sort - count
        </query>
          <earliest>$timepicker.earliest$</earliest>
          <latest>$timepicker.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.drilldown">all</option>
        <drilldown>
          <set token="src">"$click.value$"</set>
        </drilldown>
      </chart>
    </panel>
    <panel>
      <title>User Agent Distribution</title>
      <chart>
        <search>
          <query>
`netscaler-http` src=* $text_filter$
src IN ( $src$ )
dest IN ( $dest$ )
http_method IN ( $http_method$ )
status IN ( $status$ )
http_user_agent IN ( $http_user_agent$ )
source IN ( $selected_source$ )
| stats count by http_user_agent
| sort - count
        </query>
          <earliest>$timepicker.earliest$</earliest>
          <latest>$timepicker.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.drilldown">all</option>
        <drilldown>
          <set token="http_user_agent">"$click.value$"</set>
        </drilldown>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>HTTP Requests Timeline Source IP</title>
      <chart>
        <search>
          <query>
`netscaler-http` src=* $text_filter$
src IN ( $src$ )
dest IN ( $dest$ )
http_method IN ( $http_method$ )
status IN ( $status$ )
http_user_agent IN ( $http_user_agent$ )
source IN ( $selected_source$ )
| fields src dest http_method status
| timechart count by src
          </query>
          <earliest>$timepicker.earliest$</earliest>
          <latest>$timepicker.latest$</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.chart.showDataLabels">none</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="refresh.display">progressbar</option>
        <drilldown>
          <set token="src">"$click.name2$"</set>
        </drilldown>
      </chart>
    </panel>
    <panel>
      <title>HTTP Requests Timeline Destination</title>
      <chart>
        <search>
          <query>`netscaler-http` src=* $text_filter$
src IN ( $src$ )
dest IN ( $dest$ )
http_method IN ( $http_method$ )
status IN ( $status$ )
http_user_agent IN ( $http_user_agent$ )
source IN ( $selected_source$ )
| fields src dest http_method status
| timechart count by dest</query>
          <earliest>$timepicker.earliest$</earliest>
          <latest>$timepicker.latest$</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.chart.showDataLabels">none</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="refresh.display">progressbar</option>
        <drilldown>
          <set token="dest">"$click.name2$"</set>
        </drilldown>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>HTTP Status Timeline</title>
      <chart>
        <search>
          <query>
`netscaler-http` src=* $text_filter$
src IN ( $src$ )
dest IN ( $dest$ )
http_method IN ( $http_method$ )
status IN ( $status$ )
http_user_agent IN ( $http_user_agent$ )
source IN ( $selected_source$ )
| fields src dest http_method status
| timechart count by status
          </query>
          <earliest>$timepicker.earliest$</earliest>
          <latest>$timepicker.latest$</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.chart.showDataLabels">none</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="refresh.display">progressbar</option>
        <drilldown>
          <set token="status">"$click.name2$"</set>
        </drilldown>
      </chart>
    </panel>
    <panel>
      <title>HTTP Method Timeline</title>
      <chart>
        <search>
          <query>`netscaler-http` src=* $text_filter$
src IN ( $src$ )
dest IN ( $dest$ )
http_method IN ( $http_method$ )
status IN ( $status$ )
http_user_agent IN ( $http_user_agent$ )
source IN ( $selected_source$ )
| fields src dest http_method status
| timechart count by http_method</query>
          <earliest>$timepicker.earliest$</earliest>
          <latest>$timepicker.latest$</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.chart.showDataLabels">none</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="refresh.display">progressbar</option>
        <option name="charting.axisTitleX.visibility">visible</option>
        <option name="charting.axisTitleY.visibility">visible</option>
        <drilldown>
          <set token="http_method">"$click.name2$"</set>
        </drilldown>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Details</title>
      <table>
        <search>
          <query>
`netscaler-http` src=* $text_filter$
src IN ( $src$ )
dest IN ( $dest$ )
http_method IN ( $http_method$ )
status IN ( $status$ )
http_user_agent IN ( $http_user_agent$ )
source IN ( $selected_source$ )
| table _time src dest http_method uri http_version status bytes_out duration http_referrer http_user_agent
          </query>
          <earliest>$timepicker.earliest$</earliest>
          <latest>$timepicker.latest$</latest>
        </search>
        <option name="count">10</option>
        <option name="drilldown">cell</option>
        <option name="refresh.display">progressbar</option>
      </table>
    </panel>
  </row>
</form>
